#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ -n "${BRIS_PYTHON:-}" && -x "${BRIS_PYTHON}" ]]; then
    PYTHON_BIN="${BRIS_PYTHON}"
elif [[ -x "${SCRIPT_DIR}/.venv/bin/python" ]]; then
    PYTHON_BIN="${SCRIPT_DIR}/.venv/bin/python"
elif [[ -x "/home/opmir9231/bris_multisource/.venv/bin/python" ]]; then
    PYTHON_BIN="/home/opmir9231/bris_multisource/.venv/bin/python"
else
    PYTHON_BIN="$(command -v python3)"
fi

PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON_BIN" -m bris.plot_nowcast "$@"
